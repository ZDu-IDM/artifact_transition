# Local download cache — never commit artifact bytes
staging/

# Generated runtime artifacts: resume state, logs, dry-run output, most inventories.
# The PyPI inventory is kept — GitHub Pages rebuilds the index from it in CI.
manifests/*
!manifests/pypi-inventory.json

# Generated PEP 503 index — rebuilt from the inventory by CI / `migrate.py transform`.
docs/simple/

# Secrets
.env
.npmrc

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors / IDEs
.idea/
.vscode/
