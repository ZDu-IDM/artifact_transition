# Local download cache — never commit artifact bytes
staging/

# Generated runtime artifacts: logs, dry-run output, most inventories.
# Kept (committed): the PyPI inventory (GitHub Pages rebuilds the index from it)
# and the resume ledger state.json (so published status is visible everywhere and
# CI runs resume from it — the migrate workflow commits it back after each run).
manifests/*
!manifests/pypi-inventory.json
!manifests/state.json

# Generated PEP 503 index — rebuilt from the inventory by CI / `migrate.py transform`.
docs/simple/

# Generated migration report — rebuilt by `migrate.py report`.
report/

# Secrets
.env
.npmrc

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors / IDEs
.idea/
.vscode/
